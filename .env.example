# --- LLM Provider ---
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# "openrouter/auto" lets OpenRouter pick a suitable model; set a
# specific model ID (e.g. "meta-llama/llama-3.1-8b-instruct:free") to
# pin it instead.
OPENROUTER_MODEL=openrouter/auto

# --- LLM Fallback Provider ---
# Used only when OpenRouter is unconfigured or a call to it fails.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Check available model names for your key in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# Sampling temperature, 0.0-2.0. Lower = more literal/consistent answers,
# higher = more varied/creative. Kept low since answers should stick to
# the retrieved document context.
GEMINI_TEMPERATURE=0.2

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector Store ---
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=rag_documents

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5
# Minimum cosine similarity ([-1, 1]) for a chunk to count as relevant.
SIMILARITY_THRESHOLD=0.2

# --- RAG Behavior ---
# false (default): answer from documents when possible, otherwise fall
# back to the model's general knowledge (source shown in the UI either
# way). true: only ever answer from documents, refusing otherwise.
STRICT_DOCUMENT_MODE=false
