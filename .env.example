# --- LLM Provider ---
# Primary provider. Get a key at https://console.groq.com/keys.
GROQ_API_KEY=your_groq_api_key_here
# Any chat model your key can use (GET https://api.groq.com/openai/v1/models), or
# "auto": simple questions -> GROQ_FAST_MODEL, complex ones -> GROQ_STRONG_MODEL.
GROQ_MODEL=auto
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b

# OpenRouter — the previous primary answer provider, disabled for now; its
# key now reads charts and tables from page images (VISION_MODEL below).
# Get a key at https://openrouter.ai/keys and uncomment; without it, short
# PDFs are read from their text and footnotes only.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# "openrouter/auto" lets OpenRouter pick a suitable model; set a
# specific model ID (e.g. "meta-llama/llama-3.1-8b-instruct:free") to
# pin it instead.
# OPENROUTER_MODEL=openrouter/auto

# --- LLM Fallback Provider ---
# Used only when Groq is unconfigured or a call to it fails.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Check available model names for your key in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# Sampling temperature, 0.0-2.0. Lower = more literal/consistent answers,
# higher = more varied/creative. Kept low since answers should stick to
# the retrieved document context.
GEMINI_TEMPERATURE=0.2

# --- Charts, tables and footnotes (short visual PDFs) ---
# Vision model on OpenRouter that transcribes charts, tables and call-outs
# from rendered pages, cached once read. Comma-separated models are tried in
# order. These are free (rate-limited); paid models such as
# google/gemini-3.8-flash need OpenRouter credits.
VISION_MODEL=dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free
# Only for PDFs up to this many pages (one vision call per page); 0 = off.
VISUAL_READING_MAX_PAGES=30
VISION_CACHE_DIR=data/vision_cache

# --- Embeddings ---
# Device for local models (embeddings, reranker): cpu (default), cuda, mps, or auto.
# On Intel Macs, mps measured 4-10x slower than cpu for these small models.
MODEL_DEVICE=cpu
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Instruction prepended to queries only, for models that expect one
# (e.g. BAAI/bge-small-en-v1.5: "Represent this sentence for searching relevant passages: ")
EMBEDDING_QUERY_PREFIX=

# --- Speech-to-text (attached video/audio) ---
# faster-whisper model: tiny, base, small, medium (bigger = more accurate, slower)
WHISPER_MODEL=base

# --- Vector Store ---
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=rag_documents

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# "recursive" (paragraph/line/sentence/word boundaries) or "sentence" (whole
# sentences only, overlapping by whole sentences).
CHUNK_STRATEGY=recursive
# What CHUNK_SIZE/CHUNK_OVERLAP count: "chars" or "tokens" (the embedding model's
# tokens; all-MiniLM-L6-v2 embeds only the first 256 tokens of a chunk).
CHUNK_UNIT=chars

# --- Retrieval ---
TOP_K=5
# Minimum cosine similarity ([-1, 1]) for a chunk to count as relevant.
SIMILARITY_THRESHOLD=0.2
# Cross-encoder that reorders retrieved candidates before they reach the LLM
# (leave empty to disable), and how many candidates it chooses TOP_K from.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
# Hybrid search: also rank chunks by exact words (BM25) and merge that ranking
# with the embedding search, so exact names and figures ("FDsys", "802,834") are
# found. KEYWORD_CANDIDATES = how many BM25 candidates join each search.
HYBRID_SEARCH=true
KEYWORD_CANDIDATES=20
# Detect chapters/sections in structured PDFs, label chunks with them, and search
# only the sections a question names ("according to the executive summary…").
SECTION_AWARE=true
# Where section headings come from: "auto" (PDF bookmarks, or headings found by
# font size when a PDF has none), "bookmarks" or "fonts".
STRUCTURE_SOURCE=auto
# Route questions to sections by "rules" (the sections a question names) or
# "llm" (rules first; a question naming none gets one short LLM call, e.g.
# "India" -> South Asia).
QUERY_ROUTING=rules

# --- RAG Behavior ---
# false (default): answer from documents when possible, otherwise fall
# back to the model's general knowledge (source shown in the UI either
# way). true: only ever answer from documents, refusing otherwise.
STRICT_DOCUMENT_MODE=false
# Rewrite each question with the LLM before searching: fixes typos and turns
# follow-ups ("and my cholesterol?") into standalone queries. One extra short LLM call.
QUERY_REWRITING=true
# Auto mode: the LLM decides whether, how often and with what wording to search
# (like ChatGPT/Claude tools). Needs Groq; can also be toggled in the sidebar.
AGENT_MODE=true
AGENT_MAX_SEARCHES=3
